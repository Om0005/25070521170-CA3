# ---------------------------------------------------------
# OPTIONAL. The server runs with built-in local defaults when
# this file is absent, so a fresh clone works with `npm start`.
# Copy it only to override the defaults:
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ---------------------------------------------------------

# Port the Express API listens on
PORT=5000

# MongoDB connection string
# Local (MongoDB Compass / mongod running on your machine):
MONGO_URI=mongodb://127.0.0.1:27017/college_admin
# Cloud (MongoDB Atlas) - replace with your own cluster string:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college_admin?retryWrites=true&w=majority

# Secret used to sign JWT tokens (use a long random string in real projects)
JWT_SECRET=super-secret-change-me-college-admin-2026
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS (comma separated)
CLIENT_URL=http://localhost:5173

# Set to "production" when deploying
NODE_ENV=development
